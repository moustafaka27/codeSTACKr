        "world = ['High','Low','Low','High','Low','High','Low','Low']   # High at 0,3,5\n",
        "n = len(world)\n",
        "p_hit, p_miss = 0.7, 0.2\n",
        "p_exact, p_over = 0.8, 0.1\n",
        "p_under = 1 - p_exact - p_over        # 0.1\n",
        "U = 2\n",
        "\n",
        "def sense(p, Z):\n",
        "    q = [p[i] * (p_hit if world[i] == Z else p_miss) for i in range(n)]\n",
        "    s = sum(q)\n",
        "    return [x / s for x in q]          # normalize\n",
        "\n",
        "def move(p, U):\n",
        "    q = [0.0] * n\n",
        "    for i in range(n):\n",
        "        q[(i + U)     % n] += p_exact * p[i]\n",
        "        q[(i + U + 1) % n] += p_over  * p[i]\n",
        "        q[(i + U - 1) % n] += p_under * p[i]\n",
        "    return q\n",
        "\n",
        "p = [1/n] * n\n",
        "for step, Z in [(\"sense\", 'High'), (\"move\", None), (\"sense\", 'High'), (\"move\", None)]:\n",
        "    p = sense(p, Z) if step == \"sense\" else move(p, U)\n",
        "    print(step, [round(x, 4) for x in p])"
