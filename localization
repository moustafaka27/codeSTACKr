      "source": [
        "# 2D Histogram Filter (Markov localization) on a grid world\n",
        "\n",
        "# ---------------- World ----------------\n",
        "ROWS, COLS = 2, 4\n",
        "HIGH_CELLS = [(0, 0), (0, 3), (1, 1)]           # (row, col) of High cells\n",
        "world = [['Low'] * COLS for _ in range(ROWS)]\n",
        "for r, c in HIGH_CELLS:\n",
        "    world[r][c] = 'High'\n",
        "\n",
        "# ---------------- Parameters ----------------\n",
        "p_hit, p_miss = 0.7, 0.2                        # sensor model\n",
        "p_exact, p_over = 0.8, 0.1                      # motion model\n",
        "p_under = 1 - p_exact - p_over                  # 0.1\n",
        "WRAP = True                                     # True: cyclic world, False: robot stops at the wall\n",
        "\n",
        "# ---------------- Helpers ----------------\n",
        "def sign(x):\n",
        "    return (x > 0) - (x < 0)\n",
        "\n",
        "def cell(r, c):\n",
        "    if WRAP:\n",
        "        return r % ROWS, c % COLS\n",
        "    return min(max(r, 0), ROWS - 1), min(max(c, 0), COLS - 1)\n",
        "\n",
        "def sense(p, Z):\n",
        "    q = [[p[r][c] * (p_hit if world[r][c] == Z else p_miss)\n",
        "          for c in range(COLS)] for r in range(ROWS)]\n",
        "    s = sum(map(sum, q))\n",
        "    return [[x / s for x in row] for row in q]  # normalize\n",
        "\n",
        "def move(p, dr, dc):\n",
        "    ur, uc = sign(dr), sign(dc)                 # unit step along the motion direction\n",
        "    outcomes = [((dr, dc), p_exact),            # exact\n",
        "                ((dr + ur, dc + uc), p_over),   # overshoot  (one extra step)\n",
        "                ((dr - ur, dc - uc), p_under)]  # undershoot (one step less)\n",
        "    q = [[0.0] * COLS for _ in range(ROWS)]\n",
        "    for r in range(ROWS):\n",
        "        for c in range(COLS):\n",
        "            for (mr, mc), prob in outcomes:\n",
        "                nr, nc = cell(r + mr, c + mc)\n",
        "                q[nr][nc] += prob * p[r][c]\n",
        "    return q\n",
        "\n",
        "def show(title, p):\n",
        "    print(f\"\\n{title}\")\n",
        "    for row in p:\n",
        "        print(\"  \" + \"  \".join(f\"{x:.4f}\" for x in row))\n",
        "    r, c = max(((r, c) for r in range(ROWS) for c in range(COLS)), key=lambda t: p[t[0]][t[1]])\n",
        "    print(f\"  -> most likely cell: ({r},{c})  p={p[r][c]:.4f}\")\n",
        "\n",
        "# ---------------- Run: Sense -> Move -> Sense -> Move ----------------\n",
        "measurements = ['High', 'High']\n",
        "motion = (0, 2)                                 # (d_row, d_col): 2 steps to the right\n",
        "\n",
        "p = [[1 / (ROWS * COLS)] * COLS for _ in range(ROWS)]\n",
        "show(\"Prior\", p)\n",
        "p = sense(p, measurements[0]); show(f\"Sense 1 ({measurements[0]})\", p)\n",
        "p = move(p, *motion);          show(f\"Move 1 {motion}\", p)\n",
        "p = sense(p, measurements[1]); show(f\"Sense 2 ({measurements[1]})\", p)\n",
        "p = move(p, *motion);          show(f\"Move 2 {motion}\", p)"
      ],
